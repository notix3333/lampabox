{
  "name": "lampa-letterboxd-watchlist-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "env XDG_CONFIG_HOME=../.cache/xdg-config WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir=dist",
    "dev": "env XDG_CONFIG_HOME=../.cache/xdg-config WRANGLER_SEND_METRICS=false wrangler dev --local",
    "deploy": "env XDG_CONFIG_HOME=../.cache/xdg-config WRANGLER_SEND_METRICS=false wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "domhandler": "5.0.3",
    "htmlparser2": "12.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.129.0"
  },
  "engines": {
    "node": ">=22"
  }
}
