{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lampa-letterboxd-watchlist",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "assets": {
    "directory": "../dist",
    "run_worker_first": ["/watchlist/*", "/list/*", "/watched/*"]
  }
}
